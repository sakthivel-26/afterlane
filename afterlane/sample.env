# Comma-separated Render service URLs to ping
URLS=https://afterlane.onrender.com/healthz

# Ping interval in minutes (Render Free spins down after 15 minutes idle)
INTERVAL_MINUTES=14

# Optional local active hours window in 24h "START-END" format (e.g. 09-23).
# Leave empty to ping 24/7 (~720-744h/month out of Render's 750h free workspace limit).
ACTIVE_HOURS=
